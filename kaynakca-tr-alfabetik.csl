<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="tr-TR">
  <info>
    <title>Kaynakça (Türkçe) - Alfabetik</title>
    <title-short>Kaynakça TR</title-short>
    <id>http://www.zotero.org/styles/kaynakca-tr-alfabetik</id>
    <link rel="self" href="http://www.zotero.org/styles/kaynakca-tr-alfabetik"/>
    <link rel="documentation" href="https://www.zotero.org/support/creating_styles"/>
    <author>
      <name>AutoGenerated</name>
    </author>
    <category citation-format="author-date"/>
    <category field="generic-base"/>
    <updated>2024-12-23T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="tr-TR">
    <terms>
      <term name="and">ve</term>
      <term name="accessed">E.T</term>
      <term name="bibliography">KAYNAKÇA</term>
      <term name="edition">
        <single>Baskı</single>
        <multiple>Baskı</multiple>
      </term>
    </terms>
  </locale>
  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="first" initialize-with="." delimiter=", " and="text" delimiter-precedes-last="never"/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="author-short">
    <names variable="author">
      <name form="short" delimiter=", " and="text" delimiter-precedes-last="never"/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <macro name="year-paren">
    <group prefix="(" suffix=")">
      <choose>
        <if variable="issued">
          <date variable="issued">
            <date-part name="year"/>
          </date>
        </if>
        <else>
          <text term="no date" form="short"/>
        </else>
      </choose>
    </group>
  </macro>
  <macro name="title-quoted">
    <text variable="title" text-case="title" quotes="true"/>
  </macro>
  <macro name="title-unquoted">
    <text variable="title" text-case="title"/>
  </macro>
  <macro name="edition">
    <choose>
      <if variable="edition">
        <text variable="edition" suffix=". Baskı"/>
      </if>
    </choose>
  </macro>
  <macro name="pages">
    <text variable="page" form="long"/>
  </macro>
  <macro name="access">
    <choose>
      <if variable="URL">
        <group delimiter=" ">
          <text variable="URL"/>
          <group prefix="(" suffix=")">
            <text value="E.T"/>
            <text value=": " prefix=""/>
            <date variable="accessed">
              <date-part name="day" form="numeric-leading-zeros"/>
              <date-part name="month" form="numeric-leading-zeros" prefix="."/>
              <date-part name="year" prefix="."/>
            </date>
          </group>
        </group>
      </if>
    </choose>
  </macro>
  <macro name="web-sort">
    <choose>
      <if type="webpage post-weblog" match="any">
        <text value="1"/>
      </if>
      <else>
        <text value="0"/>
      </else>
    </choose>
  </macro>
  <macro name="internet-heading">
    <choose>
      <if type="webpage post-weblog" match="any">
        <choose>
          <if position="first">
            <text value="İNTERNET KAYNAKLARI"/>
          </if>
        </choose>
      </if>
    </choose>
  </macro>
  <citation disambiguate-add-year-suffix="true" collapse="year" et-al-min="4" et-al-use-first="3">
    <sort>
      <key macro="author"/>
      <key variable="issued" sort="ascending"/>
      <key variable="title"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <text macro="author-short"/>
        <text macro="year-paren" prefix="" suffix=""/>
      </group>
    </layout>
  </citation>
  <bibliography hanging-indent="true" line-spacing="2" entry-spacing="0">
    <sort>
      <key macro="web-sort" sort="ascending"/>
      <key variable="citation-number" sort="ascending"/>
      <key variable="author"/>
      <key variable="title"/>
      <key variable="issued" sort="ascending"/>
    </sort>
    <layout suffix=".">
      <choose>
        <if type="article-journal article-magazine article-newspaper" match="any">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="year-paren"/>
            <text macro="title-quoted"/>
            <group delimiter=", ">
              <text variable="container-title" text-case="title"/>
              <group>
                <text variable="volume"/>
                <text variable="issue" prefix="(" suffix=")"/>
              </group>
              <text macro="pages"/>
            </group>
          </group>
        </if>
        <else-if type="book" match="any">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="year-paren"/>
            <text macro="title-unquoted"/>
            <group delimiter=", ">
              <text variable="publisher"/>
              <text macro="edition"/>
              <text variable="publisher-place"/>
            </group>
          </group>
        </else-if>
        <else-if type="thesis" match="any">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="year-paren"/>
            <text macro="title-quoted"/>
            <group delimiter=", ">
              <text variable="genre" text-case="title"/>
              <text variable="publisher"/>
              <text variable="publisher-place"/>
            </group>
          </group>
        </else-if>
        <else-if type="paper-conference" match="any">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="year-paren"/>
            <text macro="title-unquoted"/>
            <group delimiter=", ">
              <text variable="container-title" text-case="title"/>
              <group delimiter=", ">
                <text variable="publisher-place"/>
                <text variable="publisher"/>
              </group>
              <text macro="pages"/>
            </group>
          </group>
        </else-if>
        <else-if type="chapter" match="any">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="year-paren"/>
            <text macro="title-quoted"/>
            <group delimiter=", ">
              <group delimiter=" ">
                <text term="in" text-case="capitalize-first" suffix=":"/>
                <names variable="editor">
                  <name initialize-with="." delimiter=", " and="text" delimiter-precedes-last="never"/>
                </names>
              </group>
              <text variable="container-title" text-case="title"/>
              <group delimiter=", ">
                <text variable="publisher"/>
                <text variable="publisher-place"/>
              </group>
              <text macro="pages" prefix="ss. "/>
            </group>
          </group>
        </else-if>
        <else-if type="webpage post-weblog" match="any">
          <group delimiter=" ">
            <group delimiter=" " suffix="&#10;">
              <text macro="internet-heading"/>
            </group>
            <group delimiter=" ">
              <text variable="citation-number" prefix="[" suffix="]"/>
              <group delimiter=". ">
                <text macro="author"/>
                <text macro="year-paren"/>
                <text macro="title-unquoted"/>
                <text macro="access"/>
              </group>
            </group>
          </group>
        </else-if>
        <else>
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="year-paren"/>
            <text macro="title-unquoted"/>
            <group delimiter=", ">
              <text variable="container-title" text-case="title"/>
              <text macro="pages"/>
            </group>
          </group>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
